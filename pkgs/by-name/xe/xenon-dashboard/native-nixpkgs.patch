+/// nixpkgs: the autostart plugin writes the running binary's path, which is in
+/// the Nix store, unwrapped, and gone after the next garbage collection. Point
+/// the entry at the command the wrapper names instead (looked up on PATH).
+#[cfg(all(desktop, target_os = "linux"))]
+fn nix_login_entry(app: &tauri::AppHandle) {
+    let Some(exec) = std::env::var_os("XENON_AUTOSTART_EXEC") else { return };
+    let Some(home) = std::env::var_os("HOME") else { return };
+    let file = std::path::Path::new(&home)
+        .join(".config/autostart")
+        .join(format!("{}.desktop", app.package_info().name));
+    let Ok(text) = std::fs::read_to_string(&file) else { return };
+    let exec = exec.to_string_lossy();
+    let rewritten: Vec<String> = text
+        .lines()
+        .map(|line| {
+            if line.starts_with("Exec=") {
+                format!("Exec={exec} --autostart")
+            } else {
+                line.to_string()
+            }
+        })
+        .collect();
+    let _ = std::fs::write(&file, rewritten.join("\n"));
+}
