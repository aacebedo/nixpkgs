+/// nixpkgs: pid of the engine process this app started, 0 when none.
+#[cfg(target_os = "linux")]
+static BACKEND_PID: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+/// nixpkgs: start the engine the package ships. A `systemd --user` unit named
+/// `xenon-backend.service` that the user enabled (NixOS `systemd.packages`,
+/// home-manager) owns it and keeps it running without the window; otherwise it
+/// runs as this app's child for as long as the app does.
+///
+/// Runs on the nudge thread and keeps it until the engine exits: the child asks
+/// the kernel for SIGTERM when its parent goes (PR_SET_PDEATHSIG), so an app
+/// that is killed rather than quit (logout, a crash) does not leave the engine
+/// holding the port, and that signal fires when the spawning THREAD ends.
+#[cfg(target_os = "linux")]
+fn start_nix_backend(backend: &std::ffi::OsStr, port: u16) {
+    use std::os::unix::process::CommandExt;
+    use std::sync::atomic::Ordering;
+    let systemctl = |args: &[&str]| {
+        std::process::Command::new("systemctl")
+            .arg("--user")
+            .args(args)
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .status()
+            .map(|s| s.success())
+            .unwrap_or(false)
+    };
+    if systemctl(&["--quiet", "is-enabled", "xenon-backend.service"])
+        && systemctl(&["start", "xenon-backend.service"])
+    {
+        return;
+    }
+    let mut command = std::process::Command::new(backend);
+    command.env("XENON_PORT", port.to_string());
+    // SAFETY: prctl is async-signal-safe and touches no memory of the parent.
+    unsafe {
+        command.pre_exec(|| {
+            extern "C" {
+                fn prctl(option: std::os::raw::c_int, ...) -> std::os::raw::c_int;
+            }
+            const PR_SET_PDEATHSIG: std::os::raw::c_int = 1;
+            const SIGTERM: std::os::raw::c_ulong = 15;
+            prctl(PR_SET_PDEATHSIG, SIGTERM);
+            Ok(())
+        });
+    }
+    let Ok(mut child) = command.spawn() else { return };
+    let pid = child.id();
+    BACKEND_PID.store(pid, Ordering::SeqCst);
+    let _ = child.wait();
+    let _ = BACKEND_PID.compare_exchange(pid, 0, Ordering::SeqCst, Ordering::SeqCst);
+}
+
+/// nixpkgs: stop the engine this app started (see `start_nix_backend`). SIGTERM
+/// lets server.js shut its own children down; waits until it is gone, so a
+/// restart finds the port free. Idempotent.
+#[cfg(target_os = "linux")]
+pub fn stop_owned_backend() {
+    let pid = BACKEND_PID.swap(0, std::sync::atomic::Ordering::SeqCst);
+    if pid == 0 {
+        return;
+    }
+    let _ = std::process::Command::new("kill")
+        .args(["-TERM", &pid.to_string()])
+        .status();
+    let proc_dir = std::path::PathBuf::from(format!("/proc/{pid}"));
+    for _ in 0..100 {
+        if !proc_dir.exists() {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(100));
+    }
+}
